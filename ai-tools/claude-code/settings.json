{
  "permissions": {
    "allow": [
      "Bash(linear-cli *)",
      "Bash(gh api graphql *)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime --stealth"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime --stealth"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "rudel hooks claude session-end",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/christopherbartling/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "context-mode@context-mode": true,
    "beads@beads-marketplace": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "beads-marketplace": {
      "source": {
        "source": "github",
        "repo": "gastownhall/beads"
      }
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "autoMemoryDirectory": "~/.claude/memory/",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "if [ -f '/Users/christopherbartling/.orca/agent-hooks/claude-statusline.sh' ] && [ -r '/Users/christopherbartling/.orca/agent-hooks/claude-statusline.sh' ] && [ -x '/Users/christopherbartling/.orca/agent-hooks/claude-statusline.sh' ]; then /bin/sh '/Users/christopherbartling/.orca/agent-hooks/claude-statusline.sh'; else cat >/dev/null 2>&1 || :; fi"
  }
}
