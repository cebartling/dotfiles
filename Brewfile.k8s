# Brewfile.k8s — Kubernetes-specific tools.
# Apply with:  brew bundle --file=$DOTFILES/Brewfile.k8s
# Kept separate from the main Brewfile because not every Mac needs k8s.

tap "skyhook-io/tap"
tap "sozercan/kubectl-ai", "https://github.com/sozercan/kubectl-ai"
tap "weaveworks/tap"

brew "derailed/k9s/k9s"
brew "helm"
brew "kubectl-ai"
brew "kubernetes-cli"
brew "kubeshark"
brew "skyhook-io/tap/radar"
brew "stern"
brew "weaveworks/tap/eksctl"

cask "freelens"
# openlens removed 2026-08-30 — dead upstream, last release 2023-06-30.
# freelens is the maintained successor.
