# Brewfile.lifetime — standalone macOS package manifest for the Life Time
# work laptop (Homebrew prefix /opt/homebrew).
# Apply with:  scripts/macOS/install_lifetime_tools.zsh  (preferred)
#         or:  brew bundle --file=$DOTFILES/Brewfile.lifetime
#
# Standalone: on the Life Time laptop this replaces the main Brewfile rather
# than adding to it, so bootstrap.sh (which applies the main Brewfile) is not
# the install path there.
#
# Hand-picked for that laptop: seeded 2026-11-13 from a `brew bundle dump` of
# the personal Mac, then cut down to the tools Life Time work needs. Add a
# tool here explicitly; nothing flows in from the main Brewfile.
#
# The install script trusts every third-party tap referenced below via
# scripts/macOS/lib/brew_trust.sh before running `brew bundle`, same as the
# other Brewfiles — so no `trusted:` options are needed on the tap lines.

# ===== Taps =====
tap "azure/azd"
tap "stablyai/orca"

# ===== Formulae =====
brew "atuin"                       # Improved shell history for zsh, bash, fish and nushell
brew "ccusage"                     # CLI tool for analyzing Claude Code usage from local JSONL files
brew "cliclick"                    # Tool for emulating mouse and keyboard events
brew "coreutils"                   # GNU File, Shell, and Text utilities
brew "curl"                        # Get a file from an HTTP, HTTPS or FTP server
brew "direnv"                      # Load/unload environment variables based on $PWD
brew "eza"                         # Modern, maintained replacement for ls
brew "fastfetch"                   # Like neofetch, but much faster because written mostly in C
brew "fx"                          # Terminal JSON viewer
brew "fzf"                         # Command-line fuzzy finder written in Go
brew "gh"                          # GitHub command-line tool
brew "git"                         # Distributed revision control system
brew "helm"                        # Kubernetes package manager
brew "jq"                          # Lightweight and flexible command-line JSON processor
brew "nmap"                        # Port scanning utility for large networks
brew "nvm"                         # Manage multiple Node.js versions
brew "pandoc"                      # Swiss-army knife of markup format conversion
brew "pre-commit"                  # Framework for managing multi-language pre-commit hooks
brew "procs"                       # Modern replacement for ps written in Rust
brew "ripgrep"                     # Search tool like grep and The Silver Searcher
brew "rtk"                         # CLI proxy to minimize LLM token consumption
brew "starship"                    # Cross-shell prompt for astronauts
brew "typescript-language-server"  # Language Server Protocol implementation for TypeScript wrapping tsserver
brew "uv"                          # Extremely fast Python package installer and resolver, written in Rust
brew "xh"                          # Friendly and fast tool for sending HTTP requests
brew "yq"                          # Process YAML, JSON, XML, CSV and properties documents from the CLI
brew "zoxide"                      # Shell extension to navigate your filesystem faster
brew "zsh-autosuggestions"         # Fish-like fast/unobtrusive autosuggestions for zsh
brew "zsh-syntax-highlighting"     # Fish shell like syntax highlighting for zsh

# ===== Casks =====
cask "1password"                      # 1Password GUI
cask "1password-cli"                  # Command-line interface for 1Password
cask "agentsview"                     # Browse, search and analyse your past AI coding sessions
cask "font-3270-nerd-font"
cask "font-hack-nerd-font"
cask "font-jetbrains-mono-nerd-font"
cask "font-liberation-nerd-font"
cask "font-monaspace"
cask "freelens"                       # Kubernetes IDE
cask "handy"                          # Speech to text application
cask "keepingyouawake"                # Tool to prevent the system from going into sleep mode
cask "maccy"                          # Clipboard manager
cask "mongodb-compass"                # Interactive tool for analyzing MongoDB data
cask "moom"                           # Utility to move and zoom windows—on one display
cask "obsidian"                       # Knowledge base that works on top of a local folder of plain text Markdown files
cask "stablyai/orca/orca"             # IDE for orchestrating AI coding agents across terminals and worktrees
cask "raycast"                        # Control your tools with a few keystrokes
cask "witch"                          # Switch apps, windows, or tabs
cask "zed"                            # Multiplayer code editor
